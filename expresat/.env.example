# =============================================================================
# ExpresaT — Configuración Global (.env.example)
# =============================================================================
# NOTA DE ARQUITECTURA:
# - El Backend (FastAPI) lee variables de entorno del sistema o de `expresat/.env`.
# - El Frontend (Vite) lee variables `VITE_*` desde `expresat/frontend/.env`.
# =============================================================================

# ── Backend Configuration (FastAPI / Render) ─────────────────────────────────
PORT=8000
HOST=0.0.0.0
# Entorno de ejecución: development | production
FASTAPI_ENV=development
# EXPRESAT_DEMO_MODE: Si es true, activa las reglas geométricas deterministas
# y permite conexiones WebSocket sin requerir token JWT de Supabase.
EXPRESAT_DEMO_MODE=true

# Orígenes CORS y WebSocket permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://expresat.netlify.app,https://ecpresatt.netlify.app

# Directorio del modelo ONNX (usado cuando EXPRESAT_DEMO_MODE=false)
MODEL_DIR=./models/exported_model
CONFIDENCE_THRESHOLD=0.5

# Supabase Backend variables (Opcionales cuando EXPRESAT_DEMO_MODE=true)
SUPABASE_URL=
SUPABASE_KEY=

# ── Frontend Vite Variables (copiar a expresat/frontend/.env) ───────────────
VITE_DEMO_MODE=true
VITE_API_URL_LOCAL=http://127.0.0.1:8000
VITE_WS_URL_LOCAL=ws://127.0.0.1:8000/ws/translate
VITE_API_URL=https://expresat.onrender.com
VITE_WS_URL_PROD=wss://expresat.onrender.com/ws/translate
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TARGET_FPS=20
VITE_MODEL_COMPLEXITY=0
VITE_ENABLE_POSE=false
VITE_MEDIAPIPE_BACKEND=tasks

# ExpresaT Global Configuration (.env.example)
# Backend (FastAPI) reads env vars from the system or `expresat/.env`.
# Frontend (Vite) reads `VITE_*` variables from `expresat/frontend/.env`.

# Backend Configuration (FastAPI / Render)
PORT=8000
HOST=0.0.0.0
# Runtime environment: development | production
FASTAPI_ENV=development
# Enables deterministic geometric demo rules and allows WebSocket connections without Supabase JWT
EXPRESAT_DEMO_MODE=true

# Allowed CORS and WebSocket origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://expresat.netlify.app,https://ecpresatt.netlify.app

# ONNX model directory (used when EXPRESAT_DEMO_MODE=false)
MODEL_DIR=./models/exported_model
CONFIDENCE_THRESHOLD=0.5

# Supabase Backend variables (optional when EXPRESAT_DEMO_MODE=true)
SUPABASE_URL=
SUPABASE_KEY=

# Frontend Vite Variables (copy to expresat/frontend/.env)
VITE_DEMO_MODE=true
VITE_API_URL_LOCAL=http://127.0.0.1:8000
VITE_WS_URL_LOCAL=ws://127.0.0.1:8000/ws/translate
VITE_API_URL=https://expresat.onrender.com
VITE_WS_URL_PROD=wss://expresat.onrender.com/ws/translate
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TARGET_FPS=20
VITE_MODEL_COMPLEXITY=0
VITE_ENABLE_POSE=false
VITE_MEDIAPIPE_BACKEND=tasks

# =============================================================================
# ExpresaT Frontend (.env.example)
# Copia este archivo a `expresat/frontend/.env` para desarrollo local.
# IMPORTANTE: Vite lee las variables `VITE_*` desde `expresat/frontend/.env`.
# Nunca incluyas claves privadas (service_role) aquí.
# =============================================================================

# Modo Demo 100% en navegador (true | false)
VITE_DEMO_MODE=true

# Endpoints del Backend FastAPI (Opcional en modo demo)
VITE_API_URL_LOCAL=http://127.0.0.1:8000
VITE_WS_URL_LOCAL=ws://127.0.0.1:8000/ws/translate

# Endpoints de Producción (Render)
VITE_API_URL=https://expresat.onrender.com
VITE_WS_URL_PROD=wss://expresat.onrender.com/ws/translate

# Supabase Auth (Opcional: si se omite, el modo demo funciona sin login)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Parámetros de rendimiento MediaPipe (Hilo Principal)
# FPS objetivo de inferencia (15 a 30 recomendado para Ryzen 3 7320U / iGPU)
VITE_TARGET_FPS=20
# Complejidad del modelo (0 = Lite más rápido, 1 = Full)
VITE_MODEL_COMPLEXITY=0
# Detectar pose además de manos (false por defecto para mayor fluidez)
VITE_ENABLE_POSE=false
# Backend de MediaPipe en hilo principal ('tasks' o 'legacy')
VITE_MEDIAPIPE_BACKEND=tasks
# Ruta local de binarios WASM y modelo HandLandmarker en /public
VITE_WASM_PATH=/wasm
VITE_HAND_MODEL_PATH=/models/hand_landmarker.task

# ExpresaT Frontend (.env.example)
# Copy to `expresat/frontend/.env` for local development.
# Vite reads `VITE_*` variables from `expresat/frontend/.env`; never put secret keys here.

# Browser-only demo mode (true | false)
VITE_DEMO_MODE=true

# FastAPI Backend endpoints (optional in demo mode)
VITE_API_URL_LOCAL=http://127.0.0.1:8000
VITE_WS_URL_LOCAL=ws://127.0.0.1:8000/ws/translate

# Production endpoints (Render)
VITE_API_URL=https://expresat.onrender.com
VITE_WS_URL_PROD=wss://expresat.onrender.com/ws/translate

# Supabase Auth (optional: demo mode runs without login if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# MediaPipe performance tuning (main thread)
# Target inference FPS (15-30 recommended for Ryzen 3 7320U / iGPU)
VITE_TARGET_FPS=20
# Model complexity (0 = Lite / faster, 1 = Full)
VITE_MODEL_COMPLEXITY=0
# Also run Pose detection alongside hands (false by default for lower latency)
VITE_ENABLE_POSE=false
# MediaPipe backend on main thread ('tasks' or 'legacy')
VITE_MEDIAPIPE_BACKEND=tasks
# Local paths to WASM binaries and HandLandmarker task bundle in /public
VITE_WASM_PATH=/wasm
VITE_HAND_MODEL_PATH=/models/hand_landmarker.task

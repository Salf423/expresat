{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expresat.local/schemas/recording_raw.schema.json",
  "title": "ExpresaT Raw Development Recording",
  "description": "Esquema canonico de grabaciones crudas generadas por DevRecorder (.raw.json, v1.3.0 / v1.3.1) con manos como objetos {landmarks, categoryName, score}.",
  "type": "object",
  "required": [
    "version",
    "type",
    "recorded_at",
    "duration_ms",
    "total_frames",
    "videoWidth",
    "videoHeight",
    "frames"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "type": "string",
      "const": "expresat_dev_recording_raw"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "delegate": {
      "type": ["string", "null"],
      "enum": ["GPU", "CPU", "WASM", null]
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "total_frames": {
      "type": "integer",
      "minimum": 0
    },
    "avg_fps": {
      "type": "number",
      "minimum": 0
    },
    "min_fps_required": {
      "type": "number",
      "minimum": 0
    },
    "interval_metrics": {
      "type": "object",
      "required": ["p50_ms", "p95_ms", "max_ms", "max_allowed_ms", "gaps_over_100ms_count"],
      "additionalProperties": false,
      "properties": {
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "max_ms": { "type": "number", "minimum": 0 },
        "max_allowed_ms": { "type": "number", "minimum": 0 },
        "gaps_over_100ms_count": { "type": "integer", "minimum": 0 }
      }
    },
    "valid": {
      "type": "boolean"
    },
    "error": {
      "type": ["string", "null"]
    },
    "prompt_timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promptSegment"
      }
    },
    "videoWidth": {
      "type": "integer",
      "minimum": 1
    },
    "videoHeight": {
      "type": "integer",
      "minimum": 1
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rawFrame"
      }
    }
  },
  "$defs": {
    "landmark3D": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "visibility": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "poseLandmark": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "visibility": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "handObject": {
      "type": "object",
      "required": ["landmarks", "categoryName", "score"],
      "additionalProperties": false,
      "properties": {
        "landmarks": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": { "$ref": "#/$defs/landmark3D" }
        },
        "categoryName": {
          "type": "string",
          "enum": ["Left", "Right", "Unknown"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "handednessEntry": {
      "type": "object",
      "properties": {
        "categoryName": { "type": "string" },
        "displayName": { "type": "string" },
        "label": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "index": { "type": "integer" }
      }
    },
    "promptSegment": {
      "type": "object",
      "required": ["start_ms", "end_ms", "label", "instruction"],
      "properties": {
        "start_ms": { "type": "number", "minimum": 0 },
        "end_ms": { "type": "number", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string" },
        "subText": { "type": "string" },
        "toneFreq": { "type": "number" },
        "toneDuration": { "type": "number" }
      }
    },
    "rawFrame": {
      "type": "object",
      "required": ["t_ms", "hands", "pose"],
      "additionalProperties": false,
      "properties": {
        "t_ms": { "type": "number", "minimum": 0 },
        "videoWidth": { "type": "integer", "minimum": 1 },
        "videoHeight": { "type": "integer", "minimum": 1 },
        "hands": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/handObject" }
        },
        "handedness": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "array",
                "items": { "$ref": "#/$defs/handednessEntry" }
              },
              { "$ref": "#/$defs/handednessEntry" }
            ]
          }
        },
        "pose": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 33,
              "maxItems": 33,
              "items": { "$ref": "#/$defs/poseLandmark" }
            }
          ]
        }
      }
    }
  }
}
